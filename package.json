{
  "name": "dsbotdeck",
  "productName": "DSBotDeck",
  "version": "0.1.6",
  "private": true,
  "description": "只管理远程 DS-Bot 的独立桌面客户端，复用上游界面和手机加密链路。",
  "author": "DSBotDeck contributors",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main/index.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/upstream-resolve.mjs --test \"tests/*.test.ts\"",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@lukeburns/clatterjs": "1.0.0",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@xterm/xterm": "5.5.0",
    "@xterm/addon-fit": "0.10.0",
    "deep-view": "0.1.2",
    "jsqr": "1.4.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "typescript": "~6.0.3",
    "vite": "8.3.4"
  }
}
