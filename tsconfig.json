{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": false,
    "paths": {
      "@dsbot/link": ["../DS-Bot/link/src/index.ts"],
      "@dsbot/notices": ["../DS-Bot/mobile/src/team/notices.ts"],
      "@dsbot/gated": ["../DS-Bot/mobile/src/team/gated.ts"],
      "@dsbot/characters": ["../DS-Bot/ds-bot/src/client/characters.js"],
      "@dsbot/themes": ["../DS-Bot/ds-bot/src/client/themes.js"],
      "@dsbot/browser-policy": ["../DS-Bot/ds-bot/src/shared/browser-endpoints.js"],
      "@noble/curves/ed25519": ["./node_modules/@noble/curves/ed25519.d.ts"],
      "@noble/hashes/sha256": ["./node_modules/@noble/hashes/sha256.d.ts"],
      "@noble/ciphers/webcrypto": ["./node_modules/@noble/ciphers/webcrypto.d.ts"],
      "@lukeburns/clatterjs": ["./node_modules/@lukeburns/clatterjs/dist/index.d.ts"]
    }
  },
  "include": ["src/main/**/*.ts", "src/shared/**/*.ts", "src/preload/**/*.ts", "tests/**/*.ts"]
}
